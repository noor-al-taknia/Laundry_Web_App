        "orders_amounts_check": {
          "name": "orders_amounts_check",
          "value": "\"orders\".\"subtotal\" >= 0 AND \"orders\".\"discount\" >= 0 AND \"orders\".\"vat_amount\" >= 0 AND \"orders\".\"total_amount\" >= 0 AND \"orders\".\"amount_paid\" >= 0 AND \"orders\".\"balance\" >= 0 AND \"orders\".\"cash_received\" >= 0 AND \"orders\".\"settled_from_staff\" >= 0 AND \"orders\".\"settled_from_drawer\" >= 0"
